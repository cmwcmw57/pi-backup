Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 160; 160; 164
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: 대회맵 (주행가능)
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.75
    - Class: rviz_default_plugins/Odometry
      Name: 로버 위치
      Enabled: true
      Topic:
        Value: /odom
      Keep: 1
      Shape:
        Alpha: 1
        Color: 255; 25; 0
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6.5
      Pitch: 1.3
      Yaw: 1.57
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1500
